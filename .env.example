# Server-only. Do not commit real values. Site/legal approval and an actual
# recipient end-to-end delivery test are required before enabling inquiries.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INQUIRY_RATE_SALT=
PRIVACY_NOTICE_VERSION=
INQUIRY_DELIVERY_VERIFIED=false

# Public project credentials only. NEVER put a service_role / secret key here.
# Apply supabase/reviews.sql and provision an administrator before enabling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# For email delivery choose resend; legacy webhook remains supported.
# Recipient is the owner-confirmed site.inquiryEmail. Server secrets only.
INQUIRY_PROVIDER=resend
RESEND_API_KEY=
# Plain mailbox on a Resend-verified sending domain; not the recipient Gmail.
INQUIRY_FROM_EMAIL=
